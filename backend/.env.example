# Copy this file to .env and fill in real values. Never commit .env.

PORT=3000
FRONTEND_URL=http://localhost:5173
NODE_ENV=development

# From https://developer.spotify.com/dashboard — create an app, then add
# SPOTIFY_REDIRECT_URI below as a Redirect URI in the app's settings.
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
SPOTIFY_REDIRECT_URI=http://localhost:3000/auth/callback

# Generate both with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace_with_a_random_64_char_hex_string
ENCRYPTION_KEY=replace_with_a_random_64_char_hex_string
